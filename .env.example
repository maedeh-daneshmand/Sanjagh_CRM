# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database & Redis
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/sanjagh_crm?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth Session Secret (Mandatory in production)
SESSION_SECRET="sanjagh-secret-key-at-least-32-characters-long-crm-2026"

# Demo Mode & Seed Phones
DEMO_MODE="true"
DEMO_CODE="123456"
SEED_ADMIN_PHONE="09123456789"
SEED_MANAGER_PHONE="09120000002"
SEED_SALES_PHONE="09120000003"

# Messaging (SMS & Email)
MESSAGING_PROVIDER="fake" # fake | kavenegar | smtp
MESSAGING_ALLOWLIST="09123456789,09120000002,09120000003"

# Kavenegar (optional for live production)
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""
KAVENEGAR_SENDER=""

# SMTP (optional for live production)
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@sanjaghcrm.ir"

# BullMQ Worker (set "true" in single-container / Next.js server, or run `npm run worker` separately)
ENABLE_WORKER="true"

# AI Configuration (OpenAI-compatible)
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
